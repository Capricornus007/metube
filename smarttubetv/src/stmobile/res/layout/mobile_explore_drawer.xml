<?xml version="1.0" encoding="utf-8"?>
<!-- METUBE(explore): the side menu behind Home's compass chip (ExploreDrawer). The panel is
     frosted with the page (SheetGlass), the RGB glow (RgbGlow) over the frost. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/mobile_explore_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#99000000" />

    <FrameLayout
        android:id="@+id/mobile_explore_panel"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="true"
        android:elevation="16dp"
        android:visibility="invisible">

        <com.newtube.mobile.ui.common.RgbGlow
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/mobile_explore_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="24dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_metube_mark_art" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
